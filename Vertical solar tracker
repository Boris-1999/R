import math
from datetime import datetime, timedelta

# ==========================
# USER INPUT
# ==========================
latitude = float(input("Enter latitude: "))
longitude = float(input("Enter longitude (+East): "))
timezone = float(input("Enter timezone (UTC offset): "))
date_input = input("Enter date (YYYY-MM-DD): ")
dt = datetime.strptime(date_input, "%Y-%m-%d")

# ==========================
# JULIAN DAY
# ==========================
def julian_day(dt):
    y, m, d = dt.year, dt.month, dt.day
    if m <= 2:
        y -= 1
        m += 12
    A = math.floor(y/100)
    B = 2 - A + math.floor(A/4)
    JD = math.floor(365.25*(y + 4716)) + math.floor(30.6001*(m + 1)) + d + B - 1524.5
    return JD

JD = julian_day(dt)
T = (JD - 2451545.0) / 36525

# ==========================
# SOLAR GEOMETRY
# ==========================
L0 = (280.46646 + T*(36000.76983 + T*0.0003032)) % 360
M = 357.52911 + T*(35999.05029 - 0.0001537*T)
e = 0.016708634 - T*(0.000042037 + 0.0000001267*T)

C = (1.914602 - T*(0.004817 + 0.000014*T))*math.sin(math.radians(M)) \
    + (0.019993 - 0.000101*T)*math.sin(math.radians(2*M)) \
    + 0.000289*math.sin(math.radians(3*M))

true_long = L0 + C
omega = 125.04 - 1934.136*T
lambda_sun = true_long - 0.00569 - 0.00478*math.sin(math.radians(omega))

epsilon0 = 23 + (26 + ((21.448 - T*(46.815 + T*(0.00059 - T*0.001813))))/60)/60
epsilon = epsilon0 + 0.00256*math.cos(math.radians(omega))

# ==========================
# DECLINATION
# ==========================
delta = math.asin(
    math.sin(math.radians(epsilon)) *
    math.sin(math.radians(lambda_sun))
)

# ==========================
# EQUATION OF TIME
# ==========================
y = math.tan(math.radians(epsilon/2))**2
EoT = 4 * math.degrees(
    y*math.sin(2*math.radians(L0))
    - 2*e*math.sin(math.radians(M))
    + 4*e*y*math.sin(math.radians(M))*math.cos(2*math.radians(L0))
    - 0.5*y*y*math.sin(4*math.radians(L0))
    - 1.25*e*e*math.sin(2*math.radians(M))
)

# ==========================
# SUNRISE & SUNSET
# ==========================
phi = math.radians(latitude)

cosH = (math.cos(math.radians(90.833)) /
        (math.cos(phi)*math.cos(delta))
        - math.tan(phi)*math.tan(delta))

H0 = math.degrees(math.acos(cosH))

sunrise = 720 - 4*(longitude + H0) - EoT
sunset  = 720 - 4*(longitude - H0) - EoT

sunrise += timezone * 60
sunset  += timezone * 60

# ==========================
# SOLAR TRACKING LOOP (10 MIN INTERVAL)
# ==========================
print("\nTime      Elevation(X°)   Azimuth(Y°)")
print("-"*40)

t = sunrise
while t <= sunset:

    solar_time = (t - timezone*60 + EoT + 4*longitude) / 60
    H = math.radians(15*(solar_time - 12))

    # Elevation
    sin_alpha = math.sin(phi)*math.sin(delta) + math.cos(phi)*math.cos(delta)*math.cos(H)
    alpha = math.degrees(math.asin(sin_alpha))

    # Azimuth
    sinA = -math.sin(H)*math.cos(delta)/math.cos(math.radians(alpha))
    cosA = (math.sin(delta) - math.sin(phi)*math.sin(math.radians(alpha))) / (math.cos(phi)*math.cos(math.radians(alpha)))
    A = math.degrees(math.atan2(sinA, cosA))
    A = (A + 360) % 360

    hours = int(t//60)
    minutes = int(t % 60)

    print(f"{hours:02d}:{minutes:02d}      {alpha:7.2f}        {A:7.2f}")

    t += 1
